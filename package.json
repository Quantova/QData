{
  "name": "@quantovainc/qdata",
  "version": "0.1.1",
  "description": "Post quantum private data store attestations. Proves the register, commit, access, retention and erasure records of a private data store, with ML-DSA-65 under FIPS 204 and Quantova time proofs. Only a salted commitment leaves the party that holds the data.",
